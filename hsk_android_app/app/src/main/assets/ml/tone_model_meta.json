  "blank_index": 70,
  "num_phone_classes": 71,
  "num_tone_classes": 6,
  "grading_rules": {
    "min_phone_sim_pct": 65.0,
    "exact_match_tone_score_pct": 75.0,
    "all_tones_ok_floor_pct": 62.0,
    "sandhi_t3_t3_allowed": true,
    "damage_multipliers": {
      "EXACT_MATCH": 120,
      "TONE_LENIENT_MATCH": 50,
      "NO_MATCH": 0
    }
  },
  "tflite_deployment": {
    "recommended_variant": "int8",
    "recommended_file": "hsk_flashcard_tonenet_deploy.tflite",
    "rnn_mode": "unroll",
    "uses_select_tf_ops": false,
    "keras_parity_max_diff": 1.7e-05,
    "input_shape": [
      1,
      240,
      88
    ],
    "output_ctc_shape": [
      1,
      120,
      71
    ],
    "output_tone_shape": [
      1,
      120,
      6
    ]
  }
