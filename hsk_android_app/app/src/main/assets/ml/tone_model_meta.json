{
  "model_name": "HSK_Flashcard_DualHead_ToneNet",
  "dataset_source": "AISHELL-3 + aishell3_alignment_tone (zenbot99/paddle-speech)",
  "audio_dsp": {
    "sample_rate": 16000,
    "frame_len": 400,
    "frame_hop": 160,
    "fft_len": 512,
    "n_mels": 80,
    "n_prosody": 8,
    "n_features": 88,
    "fmin_hz": 20.0,
    "fmax_hz": 7600.0,
    "mel_norm": "global_clip_mvn",
    "pitch_extractor": "yin_cmndf",
    "pitch_min_lag": 35,
    "pitch_max_lag": 213,
    "max_audio_sec": 2.4,
    "max_frames": 240,
    "subsample_factor": 2,
    "subsampled_frames": 120,
    "prosody_channels": [
      "norm_log_f0",
      "global_log_f0",
      "delta_f0",
      "delta2_f0",
      "voicing_prob",
      "norm_log_energy",
      "delta_energy",
      "low_mid_tilt"
    ]
  },
  "tone_classes": {
    "0": "Non-Tone/Sil",
    "1": "Tone 1 (High)",
    "2": "Tone 2 (Rising)",
    "3": "Tone 3 (Dip)",
    "4": "Tone 4 (Falling)",
    "5": "Tone 5 (Neutral)"
  },
  "phoneme_vocab": [
    "a",
    "ai",
    "air",
    "an",
