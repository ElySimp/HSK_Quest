<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reveal_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_raised"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tv_reveal_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_emblem"
        android:gravity="center"
        android:text="✨"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/tv_reveal_title"
        style="@style/HqText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="SUMMON SUCCESSFUL!"
        android:textColor="@color/hq_gold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tv_reveal_status_pill"
        style="@style/HqText.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="@color/hq_jade"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="✨ NEW COMPANION!" />

    <FrameLayout
        android:layout_width="136dp"
        android:layout_height="136dp"
        android:layout_marginVertical="10dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/view_reveal_aura"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_emblem" />

        <ImageView
            android:id="@+id/iv_reveal_pet_sprite"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:contentDescription="Summoned pet preview"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_reveal_name"
        style="@style/HqText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="19sp"
        tools:text="Azure Dragon (青龙)" />

    <TextView
        android:id="@+id/tv_reveal_rarity"
        style="@style/HqText.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="@color/hq_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="LEGENDARY 🟡" />

    <TextView
        android:id="@+id/tv_reveal_buff"
        style="@style/HqText.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/hq_jade"
        android:textSize="13sp"
        tools:text="Combat Buff: ⏳ Time Extender (+3s Crit Window)" />

    <TextView
        android:id="@+id/tv_reveal_subtext"
        style="@style/HqText.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/hq_text_secondary"
        android:textSize="12sp"
        tools:text="Equipped as your active adventure companion!" />

    <!-- 10x Multi-Summon Results Scrollable List -->
    <ScrollView
        android:id="@+id/scroll_multi_results"
        android:layout_width="match_parent"
        android:layout_height="195dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:fadeScrollbars="false"
        android:padding="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/container_multi_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reveal_confirm"
        style="@style/HqButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Welcome to Sanctuary" />

</LinearLayout>
