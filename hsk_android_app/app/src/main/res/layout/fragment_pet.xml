<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <!-- Unified 3-Pill Status Bar: Gems · Coins · HP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_pet_diamonds"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:gravity="center"
                android:text="💎 0"
                android:textColor="@color/hq_sky"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_pet_coins"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:gravity="center"
                android:text="🪙 0"
                android:textColor="@color/hq_gold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_pet_player_hp"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:gravity="center"
                android:text="❤️ 100/100"
                android:textColor="@color/hq_crimson"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Quick Navigation Shortcuts: Food Shop & Summon Altar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go_shop"
                style="@style/HqButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🏪 Food Shop"
                android:textColor="@color/hq_gold"
                android:textSize="12sp"
                app:strokeColor="@color/hq_stroke_gold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go_gacha"
                style="@style/HqButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="✨ Summon Altar"
                android:textColor="@color/hq_sky"
                android:textSize="12sp"
                app:strokeColor="@color/hq_stroke_sky" />
        </LinearLayout>

        <!-- Loading State before initial Sanctuary hydration -->
        <ProgressBar
            android:id="@+id/pb_pet_loading"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:indeterminateTint="@color/hq_gold"
            android:visibility="gone" />

        <!-- Empty State: No Pet Owned -->
        <LinearLayout
            android:id="@+id/layout_no_pet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_gold_border"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone"
            tools:visibility="visible">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">

                <View
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_glow_aura" />

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_emblem"
                    android:gravity="center"
                    android:text="🥚"
                    android:textSize="34sp" />
            </FrameLayout>

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="No Companion Summoned"
                android:textColor="@color/hq_gold"
                android:textSize="18sp" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Your sanctuary is waiting. Visit the Celestial Altar to summon your first guardian companion!"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_goto_gacha"
                style="@style/HqButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="✨ Summon at Celestial Altar" />
        </LinearLayout>

        <!-- Active Pet State -->
        <LinearLayout
            android:id="@+id/layout_has_pet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Habitat & Animation Stage with Sanctuary Glow Aura -->
            <LinearLayout
                android:id="@+id/card_pet_stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_gold_border"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Name & Rarity Pill Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_pet_name"
                        style="@style/HqText.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/hq_gold"
                        android:textSize="18sp"
                        tools:text="Wood Rat (木鼠)" />

                    <TextView
                        android:id="@+id/tv_pet_rarity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_stat_box"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/hq_jade"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="🟢 Common" />
                </LinearLayout>

                <!-- Buff Badge -->
                <TextView
                    android:id="@+id/tv_pet_buff"
                    style="@style/HqText.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/hq_text_secondary"
                    android:textSize="12sp"
                    tools:text="Buff: 🛡️ Shield (Blocks 1 monster attack on mistake)" />

                <!-- Companion Speech Bubble -->
                <TextView
                    android:id="@+id/tv_pet_speech"
                    style="@style/HqText.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_stat_box"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="🐾 Tap me to pet! · Click Feed to choose a treat!"
                    android:textColor="@color/hq_gold"
                    android:textSize="12sp" />

                <!-- Sprite Animation Container with Radial Sanctuary Glow -->
                <FrameLayout
                    android:layout_width="168dp"
                    android:layout_height="136dp"
                    android:layout_marginVertical="8dp">

                    <View
                        android:id="@+id/view_pet_aura"
                        android:layout_width="148dp"
                        android:layout_height="148dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_glow_aura" />

                    <ImageView
                        android:id="@+id/iv_pet_sprite"
                        android:layout_width="148dp"
                        android:layout_height="118dp"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:contentDescription="Pet Animation"
                        android:focusable="true"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <!-- Pet Mood / Tamagotchi Status -->
                <TextView
                    android:id="@+id/tv_pet_mood"
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hq_text_secondary"
                    android:textSize="13sp"
                    tools:text="✨ Feeling happy and energetic!" />

                <!-- Affection Meter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HqText.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Companion Affection"
                        android:textColor="@color/hq_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_affection_val"
                        style="@style/HqText.PixelStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hq_gold"
                        android:textSize="15sp"
                        tools:text="75 / 100" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_affection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="75"
                    app:indicatorColor="@color/hq_gold"
                    app:trackColor="@color/hq_bg_deep"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />
            </LinearLayout>

            <!-- Care & Mini-Games Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sanctuary Care &amp; Mini-Game"
                    android:textColor="@color/hq_gold"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play_rps"
                    style="@style/HqButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:text="🎮 Play Rock-Paper-Scissors (Free)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_feed_pet"
                    style="@style/HqButton.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="🦴 Feed Companion (Choose Treat)"
                    android:textColor="@color/hq_gold"
                    app:strokeColor="@color/hq_stroke_gold" />

                <TextView
                    android:id="@+id/tv_food_bag_subtitle"
                    style="@style/HqText.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="🎒 Bag: 0 treats · Or quick-buy Crispy Spirit Bone (15 🪙)"
                    android:textColor="@color/hq_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Pet Collection Switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Companion Roster"
                    android:textColor="@color/hq_gold"
                    android:textSize="15sp" />

                <TextView
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Equip a companion to accompany you into battle:"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_pet_collection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_pet_card" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
