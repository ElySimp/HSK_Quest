<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <TextView
            style="@style/HqText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾 Companion Pet Sanctuary"
            android:textColor="@color/hq_gold"
            android:textSize="22sp" />

        <TextView
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Care for your mythological beast to unlock passive buffs and combat protection."
            android:textColor="@color/hq_text_muted"
            android:textSize="13sp" />

        <!-- Empty State: No Pet Owned -->
        <LinearLayout
            android:id="@+id/layout_no_pet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_card_raised"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_emblem"
                android:gravity="center"
                android:text="🥚"
                android:textSize="36sp" />

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No Companion Summoned"
                android:textColor="@color/hq_gold"
                android:textSize="18sp" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Your sanctuary is currently empty. Visit the Gacha altar to summon your first mythological beast companion!"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_goto_gacha"
                style="@style/HqButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="✨ Summon at Gacha Altar" />
        </LinearLayout>

        <!-- Active Pet State -->
        <LinearLayout
            android:id="@+id/layout_has_pet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Habitat & Animation Stage -->
            <LinearLayout
                android:id="@+id/card_pet_stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_raised"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Name & Badges Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_pet_name"
                        style="@style/HqText.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/hq_gold"
                        android:textSize="18sp"
                        tools:text="Wood Rat (木鼠)" />

                    <TextView
                        android:id="@+id/tv_pet_rarity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/hq_jade"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Common 🟢" />
                </LinearLayout>

                <!-- Buff Badge -->
                <TextView
                    android:id="@+id/tv_pet_buff"
                    style="@style/HqText.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/hq_text_muted"
                    android:textSize="12sp"
                    tools:text="Buff: 🛡️ Shield (Blocks 1 monster attack on mistake)" />

                <!-- Sprite Animation Container -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="14dp">

                    <ImageView
                        android:id="@+id/iv_pet_sprite"
                        android:layout_width="160dp"
                        android:layout_height="120dp"
                        android:contentDescription="Pet Animation"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <!-- Pet Mood / Tamagotchi Status -->
                <TextView
                    android:id="@+id/tv_pet_mood"
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hq_text_secondary"
                    android:textSize="13sp"
                    tools:text="✨ Feeling happy and energetic!" />

                <!-- Affection Meter -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HqText.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Affection Meter"
                        android:textColor="@color/hq_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_affection_val"
                        style="@style/HqText.PixelStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hq_gold"
                        android:textSize="16sp"
                        tools:text="75 / 100" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_affection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="75"
                    app:indicatorColor="@color/hq_gold"
                    app:trackColor="@color/hq_surface"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="8dp" />
            </LinearLayout>

            <!-- Actions Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tamagotchi Care &amp; Mini-Games"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play_rps"
                    style="@style/HqButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🎮 Play Rock-Paper-Scissors (Free)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_feed_pet"
                    style="@style/HqButton.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🍙 Feed Snack (+15 Affection, +25 HP)" />
            </LinearLayout>

            <!-- Pet Collection Switcher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Pet Collection"
                    android:textSize="15sp" />

                <TextView
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tap 'Equip' to bring a pet into your adventure party:"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_pet_collection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_pet_card" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
