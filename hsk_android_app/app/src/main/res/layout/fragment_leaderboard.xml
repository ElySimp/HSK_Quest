<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/leaderboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 Hall of Valor"
                android:textColor="@color/hq_gold"
                android:textSize="22sp" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Weekly Victorious Damage Standings"
                android:textColor="@color/hq_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh_leaderboard"
            style="@style/HqButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="↻ Refresh"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Player's League & Weekly Standing Banner Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_gold_border"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_my_league_title"
                style="@style/HqText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hq_bronze"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="🥉 Bronze League" />

            <TextView
                android:id="@+id/tv_reset_countdown"
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hq_text_secondary"
                android:textSize="11sp"
                tools:text="⏳ Resets in 5d 04h 12m" />
        </LinearLayout>

        <!-- Rank + Weekly Damage Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR RANK"
                    android:textColor="@color/hq_text_muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_my_rank_value"
                    style="@style/HqText.PixelStat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/hq_gold"
                    android:textSize="18sp"
                    tools:text="#3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEEKLY DAMAGE"
                    android:textColor="@color/hq_text_muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_my_weekly_damage"
                    style="@style/HqText.PixelStat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/hq_crimson"
                    android:textSize="18sp"
                    tools:text="⚔️ 1,420 DMG" />
            </LinearLayout>
        </LinearLayout>

        <!-- Projected Reward + Scope Hint -->
        <TextView
            android:id="@+id/tv_projected_reward"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/hq_sky"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Projected: 💎 100 Gems" />

        <TextView
            android:id="@+id/tv_league_scope_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/hq_text_muted"
            android:textSize="11sp"
            tools:text="Competing in your tier (Areas 0–3)" />
    </LinearLayout>

    <!-- League Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_leagues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_league_bronze"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="🥉 Bronze (HSK 1–3)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_league_silver"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥈 Silver (HSK 4–5)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_league_gold"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥇 Gold (HSK 6)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_league_radiant"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 Radiant (HSK 7–9)" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pb_leaderboard_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="36dp"
        android:indeterminateTint="@color/hq_gold"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_leaderboard_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚔️"
            android:textSize="32sp" />

        <TextView
            style="@style/HqText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No Scholars in This League Yet"
            android:textSize="15sp" />

        <TextView
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Defeat Gatekeeper Bosses on the World Map to advance into higher leagues!"
            android:textColor="@color/hq_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/layout_leaderboard_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_leaderboard_error_msg"
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/hq_crimson"
            android:textSize="13sp"
            tools:text="Cannot reach the server." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry_leaderboard"
            style="@style/HqButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="Retry"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Rankings RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_leaderboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_leaderboard_rank" />

</LinearLayout>
