<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="170dp"
    android:background="@color/hq_surface"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_emblem"
        android:gravity="center"
        android:text="@string/app_logo_hanzi"
        android:textColor="@color/hq_gold"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        style="@style/HqText.HeroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/app_name" />

    <TextView
        style="@style/HqText.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/nav_header_tagline"
        android:textSize="12sp" />
</LinearLayout>
