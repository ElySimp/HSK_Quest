<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rps_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_raised"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle bar indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card" />

    <TextView
        style="@style/HqText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rock · Paper · Scissors"
        android:textColor="@color/hq_gold"
        android:textSize="20sp" />

    <TextView
        style="@style/HqText.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Play against your pet! Wins increase affection and can drop bonus coins."
        android:textSize="12sp" />

    <!-- 3 Choice Buttons -->
    <LinearLayout
        android:id="@+id/layout_choices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <!-- Rock -->
        <LinearLayout
            android:id="@+id/btn_choice_rock"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_option_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪨"
                android:textSize="32sp" />

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rock"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Paper -->
        <LinearLayout
            android:id="@+id/btn_choice_paper"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_option_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄"
                android:textSize="32sp" />

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Paper"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Scissors -->
        <LinearLayout
            android:id="@+id/btn_choice_scissors"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_option_idle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✂️"
                android:textSize="32sp" />

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Scissors"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Outcome Card (Shown after pick) -->
    <LinearLayout
        android:id="@+id/layout_outcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_gold_border"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_rps_vs"
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hq_text_muted"
            android:textSize="13sp"
            tools:text="You: 🪨 Rock  vs  Pet: ✂️ Scissors" />

        <TextView
            android:id="@+id/tv_rps_title"
            style="@style/HqText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/hq_gold"
            android:textSize="20sp"
            tools:text="VICTORY! 🎉" />

        <TextView
            android:id="@+id/tv_rps_message"
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/hq_jade"
            android:textSize="13sp"
            tools:text="+10 Affection! Dropped 12 bonus coins!" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_rps"
        style="@style/HqButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Back to Sanctuary" />

</LinearLayout>
