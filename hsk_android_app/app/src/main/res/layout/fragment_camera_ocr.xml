<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hq_bg_deep"
    android:orientation="vertical"
    tools:context=".ui.ocr.CameraOcrFragment">

    <!-- Camera Preview + Reticle Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview_view_ocr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <com.faldo.hsk_quest.ui.ocr.CameraOcrOverlayView
            android:id="@+id/ocr_overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Floating HUD Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#88080D16"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/btn_ocr_back"
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_stat_box"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="← Back"
                android:textColor="@color/hq_gold"
                android:textSize="13sp" />

            <TextView
                style="@style/HqText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="📷 Live Hanzi OCR"
                android:textColor="@color/hq_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_ocr_polarity"
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_stat_box"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="🌓 Dark Ink"
                android:textColor="@color/hq_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_ocr_torch"
                style="@style/HqText.Title"
                android:layout_width="34dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_stat_box"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🔦"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Processed ROI Thumbnail Preview (shows exact input fed to TFLite) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageView
                android:id="@+id/iv_ocr_model_preview"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@android:color/white"
                android:contentDescription="Preprocessed Hanzi input"
                android:scaleType="fitCenter" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI View"
                android:textColor="@color/hq_text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Camera Permission Fallback Card -->
        <LinearLayout
            android:id="@+id/layout_ocr_permission_denied"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/hq_bg_deep"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Camera Access Needed"
                android:textColor="@color/hq_gold"
                android:textSize="18sp" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Grant Camera permission to scan printed or handwritten Hanzi in real time using our offline TFLite model."
                android:textColor="@color/hq_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_grant_camera_permission"
                style="@style/HqButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:text="Enable Camera" />
        </LinearLayout>
    </FrameLayout>

    <!-- Scanner Controls Row: Mode Toggle + Box Size + Freeze -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hq_surface_high"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/btn_mode_single"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_stat_box"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="1 Hanzi"
            android:textColor="@color/hq_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_mode_multi"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Multi-Hanzi"
            android:textColor="@color/hq_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_roi_size"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="📐 Box: M"
            android:textColor="@color/hq_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_ocr_freeze"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_stat_box"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="⏸ Freeze"
            android:textColor="@color/hq_jade"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Pleco-Style Live Dictionary Output Card -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.85"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_raised"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ocr_hanzi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/hq_gold"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_ocr_pinyin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Point camera box at Hanzi"
                        android:textColor="@color/hq_jade"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_ocr_meta"
                        style="@style/HqText.Subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Google ML Kit Chinese OCR (HSK 1-9)"
                        android:textColor="@color/hq_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_ocr_speak"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_stat_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🔊"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_ocr_english"
                style="@style/HqText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Real-time Pinyin and definition will appear here automatically."
                android:textColor="@color/hq_text_primary"
                android:textSize="14sp" />

            <!-- Top-K Alternative / Multi-Character Breakdown Chips -->
            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Top candidates / breakdown (tap to inspect):"
                android:textColor="@color/hq_text_muted"
                android:textSize="11sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_ocr_alternatives"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ocr_open_dict"
                style="@style/HqButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="🔍 Open in Dictionary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
