<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shop_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <!-- Child 1: Main Shop Content (gets 40% blur during checkout) -->
    <LinearLayout
        android:id="@+id/shop_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 1. Ultra-Compact Single-Line Top Bar (38dp height) -->
        <LinearLayout
            android:id="@+id/layout_shop_top_bar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_shop_back"
                style="@style/HqButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="34dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="← Hub"
                android:textColor="@color/hq_gold"
                android:textSize="12sp"
                android:visibility="gone"
                app:strokeColor="@color/hq_stroke_gold"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_shop_hp"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hq_crimson"
                android:textSize="15sp"
                tools:text="❤️ 100/100" />

            <TextView
                android:id="@+id/tv_shop_coins"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hq_gold"
                android:textSize="15sp"
                tools:text="🪙 1,250" />

            <TextView
                android:id="@+id/tv_shop_diamonds"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:textColor="@color/hq_sky"
                android:textSize="15sp"
                tools:text="💎 2,500" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_shop_cart"
                style="@style/HqButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="34dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="🛒 0"
                android:textColor="@color/hq_gold"
                android:textSize="12sp"
                app:strokeColor="@color/hq_stroke_gold" />
        </LinearLayout>

        <!-- 2. View 1: Merchant Hub (Storefront Selection) -->
        <ScrollView
            android:id="@+id/layout_shop_hub"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="72dp">

                <!-- Animated Lyra (Mage Girl) Shopkeeper Card -->
                <LinearLayout
                    android:id="@+id/card_merchant_npc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_gold_border"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/iv_merchant_npc"
                        android:layout_width="80dp"
                        android:layout_height="54dp"
                        android:contentDescription="Shopkeeper NPC"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_merchant_name"
                            style="@style/HqText.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧙‍♀️ Lyra · Grand Market Quartermaster"
                            android:textColor="@color/hq_gold"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_merchant_dialogue"
                            style="@style/HqText.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Welcome to the Imperial Market! Choose a specialty shop below, tap any item to inspect its stats, and add provisions to your cart!"
                            android:textColor="@color/hq_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="⛩️ Select a Specialty Merchant"
                    android:textColor="@color/hq_gold"
                    android:textSize="14sp" />

                <!-- Store 1: Crimson Cauldron Apothecary (Potions) -->
                <LinearLayout
                    android:id="@+id/card_store_potions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_stat_box">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🧪"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/HqText.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Crimson Apothecary"
                                android:textColor="@color/hq_crimson"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:singleLine="true"
                                android:text="万灵丹坊"
                                android:textColor="@color/hq_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            style="@style/HqText.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Alchemical Battle Draughts · Instant 25%–100% Max HP Recovery (Level-Scaled)"
                            android:textColor="@color/hq_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Enter →"
                        android:textColor="@color/hq_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Store 2: Imperial Pavilion Tavern (Human Food) -->
                <LinearLayout
                    android:id="@+id/card_store_food"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_stat_box">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🍜"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/HqText.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Imperial Pavilion Tavern"
                                android:textColor="@color/hq_gold"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="御膳酒楼"
                                android:textColor="@color/hq_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            style="@style/HqText.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Artisanal Human Cuisine · Higher Tier = Up to 10.0 HP per Coin Value!"
                            android:textColor="@color/hq_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Enter →"
                        android:textColor="@color/hq_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Store 3: Spirit Beast Menagerie (Pet Treats) -->
                <LinearLayout
                    android:id="@+id/card_store_pet_food"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_stat_box">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🐾"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/HqText.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Spirit Beast Menagerie"
                                android:textColor="@color/hq_jade"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="灵兽仙苑"
                                android:textColor="@color/hq_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            style="@style/HqText.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Mythical Companion Delicacies · Boosts Pet Affection &amp; Unlocks Combat Buffs"
                            android:textColor="@color/hq_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Enter →"
                        android:textColor="@color/hq_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Store 4: Adventurer's Satchel (Inventory Bag) -->
                <LinearLayout
                    android:id="@+id/card_store_bag"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_stat_box">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🎒"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/HqText.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Adventurer's Satchel"
                                android:textColor="@color/hq_sky"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="行囊背包"
                                android:textColor="@color/hq_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_hub_bag_subtitle"
                            style="@style/HqText.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Inspect Owned Provisions &amp; Eat Human Meals to Restore HP"
                            android:textColor="@color/hq_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_hub_bag_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Open →"
                        android:textColor="@color/hq_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Shortcut to Pet Sanctuary -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_feed_in_sanctuary"
                    style="@style/HqButton.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="2dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="🐾 Go to Pet Sanctuary"
                    android:textColor="@color/hq_gold"
                    android:textSize="12sp"
                    app:strokeColor="@color/hq_stroke_gold" />

            </LinearLayout>
        </ScrollView>

        <!-- 3. View 2: Store Catalog & Bag View -->
        <LinearLayout
            android:id="@+id/layout_shop_catalog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <!-- Store Header Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_gold_border"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tv_store_title"
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍜 Imperial Pavilion Tavern (御膳酒楼)"
                    android:textColor="@color/hq_gold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_store_subtitle"
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tap any dish for full stats &amp; lore · Use (-) 1 (+) to add to cart"
                    android:textColor="@color/hq_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_shop_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:indeterminateTint="@color/hq_gold"
                android:visibility="gone" />

            <!-- Items RecyclerView + Empty State -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_shop_items"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="72dp"
                    tools:listitem="@layout/item_shop_card" />

                <LinearLayout
                    android:id="@+id/ll_shop_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_empty_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎒"
                        android:textSize="48sp" />

                    <TextView
                        android:id="@+id/tv_empty_title"
                        style="@style/HqText.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Your satchel is empty"
                        android:textColor="@color/hq_text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_empty_desc"
                        style="@style/HqText.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Visit the Imperial Market stores to stock up on potions, meals, and pet delicacies!"
                        android:textColor="@color/hq_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Bottom Floating Cart Bar -->
            <LinearLayout
                android:id="@+id/card_floating_checkout_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_gold_border"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_floating_cart_summary"
                    style="@style/HqText.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛒 3 Items · 120 🪙"
                    android:textColor="@color/hq_gold"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_proceed_checkout"
                    style="@style/HqButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="36dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="0dp"
                    android:text="Checkout →"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. View 3: Checkout Confirmation Screen -->
        <LinearLayout
            android:id="@+id/layout_shop_checkout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_gold_border"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧾 Imperial Market Checkout"
                    android:textColor="@color/hq_gold"
                    android:textSize="15sp" />

                <TextView
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Review your selected provisions before confirming payment:"
                    android:textColor="@color/hq_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <!-- Dynamically populated checkout item rows -->
                    <LinearLayout
                        android:id="@+id/ll_checkout_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Order Summary Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            style="@style/HqText.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Order Summary"
                            android:textColor="@color/hq_gold"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_checkout_total_items"
                            style="@style/HqText.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/hq_text_primary"
                            android:textSize="12sp"
                            tools:text="Total Provisions: 3 item(s)" />

                        <TextView
                            android:id="@+id/tv_checkout_total_heal"
                            style="@style/HqText.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/hq_jade"
                            android:textSize="12sp"
                            tools:text="Total Recovery Value: +525 Hero HP" />

                        <TextView
                            android:id="@+id/tv_checkout_total_cost"
                            style="@style/HqText.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/hq_gold"
                            android:textSize="14sp"
                            tools:text="Total Cost: 105 🪙" />

                        <TextView
                            android:id="@+id/tv_checkout_balance_after"
                            style="@style/HqText.Subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/hq_text_secondary"
                            android:textSize="11sp"
                            tools:text="Remaining Balance After Payment: 1,145 🪙" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_cart"
                    style="@style/HqButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Clear Cart"
                    android:textColor="@color/hq_crimson"
                    android:textSize="12sp"
                    app:strokeColor="@color/hq_crimson" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirm_checkout"
                    style="@style/HqButton.Primary"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.5"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="✨ Confirm &amp; Pay"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Child 2: 40% Blurred Checkout Loading Overlay with Random Gameplay Tip -->
    <FrameLayout
        android:id="@+id/layout_shop_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#990E0E12"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/bg_card_gold_border"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <ProgressBar
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:indeterminateTint="@color/hq_gold" />

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="✨ Preparing Your Provisions..."
                android:textColor="@color/hq_gold"
                android:textSize="16sp" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Quartermaster Lyra is packing your satchel"
                android:textColor="@color/hq_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_shop_loading_tip"
                style="@style/HqText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_stat_box"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:padding="10dp"
                android:textColor="@color/hq_text_primary"
                android:textSize="11sp"
                tools:text="💡 Tip: Peking Roast Duck gives 10.0 HP per Coin — 2.5x more cost-effective than Rice Balls!" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
