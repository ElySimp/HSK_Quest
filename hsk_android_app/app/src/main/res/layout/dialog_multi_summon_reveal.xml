<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/multi_reveal_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_raised"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Emblem / Icon & Title Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_multi_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_emblem"
            android:gravity="center"
            android:text="🌟"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_multi_title"
            style="@style/HqText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="10x CELESTIAL SUMMON! 🎊"
            android:textColor="@color/hq_gold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_multi_status_pill"
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="3dp"
            android:textColor="@color/hq_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="✨ 1 LEGENDARY · 1 EPIC · 8 COMMON" />

        <TextView
            android:id="@+id/tv_multi_subtext"
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/hq_text_secondary"
            android:textSize="11.5sp"
            tools:text="10 mythical companions channeled into your Sanctuary!" />
    </LinearLayout>

    <!-- Scrollable 10-Unit Cards Container -->
    <ScrollView
        android:id="@+id/scroll_units_container"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:fadeScrollbars="false"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/container_units_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Bottom Pinned Action Button (Guaranteed Visible) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_multi_confirm"
        style="@style/HqButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🐾 Collect All to Sanctuary" />

</LinearLayout>
