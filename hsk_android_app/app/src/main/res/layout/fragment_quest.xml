<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quest_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- Top Wallet & Date Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_quest_diamonds"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:singleLine="true"
                android:text="💎 0"
                android:textColor="@color/hq_sky"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_quest_coins"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stat_box"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:singleLine="true"
                android:text="🪙 0"
                android:textColor="@color/hq_gold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_quest_date"
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_stat_box"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:textColor="@color/hq_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="UTC 2026-11-14" />
        </LinearLayout>

        <!-- Daily Quest Mastery Summary Card -->
        <LinearLayout
            android:id="@+id/card_quest_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_gold_border"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daily Diamond Quests"
                    android:textColor="@color/hq_gold"
                    android:textSize="18sp" />

                <TextView
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_box"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="100–200 💎/day"
                    android:textColor="@color/hq_sky"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_quest_completion_summary"
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/hq_text_secondary"
                android:textSize="12.5sp"
                tools:text="2 / 5 Daily Quests Completed · 2 Rewards Ready" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_daily_overall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="5"
                android:progress="0"
                app:indicatorColor="@color/hq_gold"
                app:trackColor="@color/hq_bg_deep"
                app:trackCornerRadius="4dp"
                app:trackThickness="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_claim_all_quests"
                style="@style/HqButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="Complete Quests to Claim 💎"
                app:cornerRadius="12dp" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Progress updates from Battles, Pet Care, Bounty &amp; Shop · Resets 00:00 UTC"
                android:textColor="@color/hq_text_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pb_quest_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/hq_gold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_quest_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_quest_error"
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/hq_crimson"
                android:textSize="13sp"
                tools:text="Failed to load Daily Quests" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quest_retry"
                style="@style/HqButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Retry" />
        </LinearLayout>

        <!-- Daily Quest Checklist -->
        <TextView
            style="@style/HqText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:text="Today's 5 Missions"
            android:textColor="@color/hq_gold"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/container_daily_quests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
