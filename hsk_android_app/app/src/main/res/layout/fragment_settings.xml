<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <!-- Header Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gold_border"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/HqText.HeroName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ CAT-QUEST Settings"
                android:textSize="20sp" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Switch the battle question scheduler between Rule-Based baseline (Engine A) and Machine Learning CAT (Engine B)."
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Mode:"
                    android:textColor="@color/hq_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_settings_active_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_stat_box"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/hq_gold"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Engine A · Rule-Based" />
            </LinearLayout>
        </LinearLayout>

        <!-- Question Engine Section -->
        <TextView
            style="@style/HqText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Battle Question Engine"
            android:textColor="@color/hq_gold"
            android:textSize="16sp" />

        <!-- Option A: Rule-Based -->
        <LinearLayout
            android:id="@+id/card_engine_rule_based"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_gold_border"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_rule_radio"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_stat_box"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="@color/hq_gold"
                    android:textSize="14sp" />

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Engine A · Rule-Based"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_rule_status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_box"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="READY"
                    android:textColor="@color/hq_jade"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Persistent full-level Shuffle-Bag deck + 3-turn cooldown re-queue on missed words + deterministic mastery (+15 / -20) + level-strict Cloze bank."
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Option B: ML Adaptive CAT -->
        <LinearLayout
            android:id="@+id/card_engine_ml_cat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ml_radio"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_stat_box"
                    android:gravity="center"
                    android:text="○"
                    android:textColor="@color/hq_text_muted"
                    android:textSize="14sp" />

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Engine B · ML Adaptive CAT"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_ml_status_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_box"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/hq_violet"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    tools:text="PENDING MODEL" />
            </LinearLayout>

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Predicts recall probability via on-device cat_scheduler.tflite and targets the ~70-75% Flow Zone for adaptive spaced review."
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Safe Fallback Notice when ML model isn't trained/bundled yet -->
        <LinearLayout
            android:id="@+id/banner_ml_fallback_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️ Pending TFLite Model (Safe Fallback Active)"
                android:textColor="@color/hq_violet"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ML Adaptive CAT mode is saved, but assets/ml/cat_scheduler.tflite has not been added yet. Battles will safely fall back to Engine A (Rule-Based) until the Kaggle .ipynb model is bundled."
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Sensor AI Modules Status -->
        <TextView
            style="@style/HqText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="On-Device Sensor AI Status"
            android:textColor="@color/hq_gold"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✍️ Handwriting CNN"
                    android:textColor="@color/hq_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_handwriting_ai_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hq_jade"
                    android:textSize="12sp"
                    tools:text="Active (TFLite)" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/hq_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎙️ Speaking ToneNet"
                    android:textColor="@color/hq_text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_speaking_ai_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hq_jade"
                    android:textSize="12sp"
                    tools:text="Active (TFLite)" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
