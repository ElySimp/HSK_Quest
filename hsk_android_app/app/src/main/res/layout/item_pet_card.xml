<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_pet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card_common_border"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Rarity & Status Pill Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_pet_thumb_rarity"
            style="@style/HqText.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hq_gold"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="🟡 LEGENDARY" />

        <TextView
            android:id="@+id/tv_pet_thumb_status"
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_box"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@color/hq_gold"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="★ ACTIVE"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Sprite Thumbnail -->
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_stat_box">

        <View
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_glow_aura" />

        <ImageView
            android:id="@+id/iv_pet_thumb"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:contentDescription="Pet thumbnail"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Name -->
    <TextView
        android:id="@+id/tv_pet_thumb_name"
        style="@style/HqText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/hq_text_primary"
        android:textSize="13sp"
        tools:text="Azure Dragon" />

    <!-- Combat Perk Badge -->
    <TextView
        android:id="@+id/tv_pet_thumb_buff"
        style="@style/HqText.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/hq_jade"
        android:textSize="10sp"
        tools:text="+25% DMG • +2.5s • Crit Heal" />

    <!-- Compact Affection Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_thumb_affection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:max="100"
            app:indicatorColor="@color/hq_gold"
            app:trackColor="@color/hq_bg_deep"
            app:trackCornerRadius="3dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/tv_thumb_affection"
            style="@style/HqText.PixelStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hq_text_secondary"
            android:textSize="10sp"
            tools:text="♥ 80" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_equip_thumb"
        style="@style/HqButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="34dp"
        android:padding="0dp"
        android:text="Equip"
        android:textColor="@color/hq_gold"
        android:textSize="11sp"
        app:cornerRadius="10dp"
        app:strokeColor="@color/hq_stroke_gold" />

</LinearLayout>
