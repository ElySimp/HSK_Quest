<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            style="@style/HqText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_practice"
            android:textColor="@color/hq_gold"
            android:textSize="22sp" />

        <TextView
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Phase 2D Input Shells: Hanzi Stroke Writing &amp; Speaking Laboratory"
            android:textColor="@color/hq_text_muted"
            android:textSize="13sp" />

        <!-- Card 1: Hanzi Writing Canvas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_raised"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Writing Challenge: 爱 (ài)"
                android:textColor="@color/hq_gold"
                android:textSize="16sp" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Practice drawing strokes on the Tianzige grid (min 2 strokes to attack):"
                android:textSize="12sp" />

            <!-- Custom Writing Canvas -->
            <com.faldo.hsk_quest.ui.battle.CanvasWritingView
                android:id="@+id/canvas_writing"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_stroke_count"
                    style="@style/HqText.PixelStat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Strokes: 0 / 2"
                    android:textColor="@color/hq_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_stroke_feedback"
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Draw on canvas"
                    android:textColor="@color/hq_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_canvas"
                    style="@style/HqButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Clear Canvas" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_validate_canvas"
                    style="@style/HqButton.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Test Stroke Attack" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 2: Voice Audio Recorder -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_raised"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaking Challenge: 你好 (nǐ hǎo)"
                android:textColor="@color/hq_gold"
                android:textSize="16sp" />

            <TextView
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Record voice pronunciation input for AI speech evaluation:"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_audio_status"
                style="@style/HqText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:padding="14dp"
                android:text="Tap 'Record' to start audio capture"
                android:textColor="@color/hq_text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_record_audio"
                    style="@style/HqButton.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Record" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_stop_audio"
                    style="@style/HqButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Stop" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play_audio"
                    style="@style/HqButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Play" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
