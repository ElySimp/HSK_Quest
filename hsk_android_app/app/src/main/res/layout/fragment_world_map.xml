<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/world_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <!-- Row 1: Compact Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/HqButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="34dp"
            android:paddingHorizontal="10dp"
            android:text="‹ Back"
            android:textSize="12sp" />

        <TextView
            style="@style/HqText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🗺️ World Map"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_area_lock_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/hq_jade"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="🔓 Realm Open" />

        <TextView
            android:id="@+id/tv_area_cleared_stars"
            style="@style/HqText.PixelStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/hq_gold"
            android:textSize="12sp"
            tools:text="⭐ 3/9" />
    </LinearLayout>

    <!-- Row 2: Slim HSK 1–9 Area Tabs ScrollView -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/area_tabs_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp" />
    </HorizontalScrollView>

    <!-- Row 3: Ultra-Slim Area Context Strip -->
    <LinearLayout
        android:id="@+id/card_area_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_card_raised"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_area_title"
                style="@style/HqText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hq_gold"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="HSK 1: Bamboo Grove (竹林幽径)" />

            <TextView
                android:id="@+id/tv_area_rec_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/hq_jade"
                android:textSize="12sp"
                tools:text="🛡️ Rec. Lv. 1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_area_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hq_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Serene mist hides fledgling wood beasts." />
    </LinearLayout>

    <!-- Scrollable Stages List -->
    <ScrollView
        android:id="@+id/scroll_world_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:id="@+id/stages_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="72dp" />
    </ScrollView>
</LinearLayout>
