<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Emoji / Item Icon Container -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_stat_box">

        <TextView
            android:id="@+id/tv_item_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="28sp"
            tools:text="🥟" />
    </FrameLayout>

    <!-- Details Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_item_name"
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Jade Dumplings" />

            <TextView
                android:id="@+id/tv_item_name_zh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/hq_text_secondary"
                android:textSize="12sp"
                tools:text="水饺" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_item_desc"
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="11sp"
            tools:text="Steamed dumplings stuffed with herbs. Restores moderate HP." />

        <!-- Stat Buff Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hp_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_box"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/hq_crimson"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="+50 HP" />

            <TextView
                android:id="@+id/tv_affection_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_stat_box"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/hq_jade"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="+20 ❤️ Affection" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Action Column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_owned_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hq_text_muted"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="Owned: 2"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_item_action"
            style="@style/HqButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:minHeight="36dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:textSize="11sp"
            tools:text="40 🪙 Buy" />
    </LinearLayout>

</LinearLayout>
