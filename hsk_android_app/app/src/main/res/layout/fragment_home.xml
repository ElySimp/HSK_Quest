<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Currency & Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_raised"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tv_diamonds"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hq_sky"
                tools:text="💎 100" />

            <TextView
                android:id="@+id/tv_coins"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/hq_gold"
                tools:text="🪙 350" />

            <TextView
                android:id="@+id/tv_survival_hp"
                style="@style/HqText.PixelStat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/hq_crimson"
                tools:text="❤️ 100" />
        </LinearLayout>

        <!-- Offline Status Badge -->
        <TextView
            android:id="@+id/tv_offline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/home_offline"
            android:textColor="@color/hq_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Hero Greeting & Level Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_greeting"
                    style="@style/HqText.HeroName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="你好, Faldo!" />

                <TextView
                    android:id="@+id/tv_level_league"
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="Lv. 1 Hero · Bronze League" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_xp_label"
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:text="0 / 100 XP" />
        </LinearLayout>

        <!-- XP Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_xp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            app:indicatorColor="@color/hq_jade"
            app:trackColor="@color/hq_surface_high"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <!-- Big Primary CTA: START ADVENTURE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_adventure"
            style="@style/HqButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="@string/home_start_adventure"
            android:textSize="18sp"
            app:icon="@android:drawable/ic_menu_compass"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/hq_bg_deep" />

        <!-- Daily Bounty (Daily Claim Card) -->
        <LinearLayout
            android:id="@+id/card_daily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_gold_border"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_daily_reward_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_daily_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hq_gold"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Streak: 1 Day" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_daily_reward_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hq_text_secondary"
                android:textSize="13sp"
                tools:text="+50 Coins login reward" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_claim_daily"
                style="@style/HqButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="@string/home_daily_claim_btn"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Companion Pet Sanctuary Card -->
        <LinearLayout
            android:id="@+id/card_companion_pet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iv_pet_sprite"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/home_pet_partner_title"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_pet_name"
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_pet_partner_title"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Your companion is resting peacefully at home."
                    android:textColor="@color/hq_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Daily Quests Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/HqText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_daily_quests_title"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/home_quest_1"
                android:textColor="@color/hq_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_quest_2"
                android:textColor="@color/hq_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
