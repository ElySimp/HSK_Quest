<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <ScrollView
        android:id="@+id/scroll_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layout_home_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="72dp">

            <!-- Top Currency & Status Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_raised"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <!-- Diamonds -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_currency_diamond"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/nav_gacha"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/tv_diamonds"
                        style="@style/HqText.PixelStat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/hq_sky"
                        tools:text="100" />
                </LinearLayout>

                <!-- Coins -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_currency_coin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/nav_shop"
                        android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tv_coins"
                    style="@style/HqText.PixelStat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/hq_gold"
                    tools:text="350" />
            </LinearLayout>

            <!-- Survival HP -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_survival_hp"
                    style="@style/HqText.PixelStat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/hq_crimson"
                    tools:text="100" />
            </LinearLayout>
        </LinearLayout>

        <!-- Offline Status Badge -->
        <TextView
            android:id="@+id/tv_offline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/home_offline"
            android:textColor="@color/hq_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Hero Greeting & Level Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_greeting"
                    style="@style/HqText.HeroName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="你好, Faldo!" />

                <TextView
                    android:id="@+id/tv_level_league"
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="Lv. 1 · 🥉 Bronze League" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_xp_label"
                style="@style/HqText.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:text="0 / 100 XP" />
        </LinearLayout>

        <!-- XP Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_xp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            app:indicatorColor="@color/hq_jade"
            app:trackColor="@color/hq_surface_high"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <!-- Big Primary CTA: START ADVENTURE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_adventure"
            style="@style/HqButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="@string/home_start_adventure"
            android:textSize="18sp"
            app:icon="@android:drawable/ic_menu_compass"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/hq_bg_deep" />

        <!-- Daily Bounty (Daily Claim Card) -->
        <LinearLayout
            android:id="@+id/card_daily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_gold_border"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_daily_reward_title"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_daily_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hq_gold"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Streak: 1 Day" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_daily_reward_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hq_text_secondary"
                android:textSize="13sp"
                tools:text="+50 Coins login reward" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_claim_daily"
                style="@style/HqButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="@string/home_daily_claim_btn"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Companion Pet Sanctuary Card -->
        <LinearLayout
            android:id="@+id/card_companion_pet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_gold_border"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🐾 Tamagotchi Sanctuary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Sanctuary ›"
                    android:textColor="@color/hq_gold"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- State: Has Active Pet -->
            <LinearLayout
                android:id="@+id/layout_has_pet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iv_pet_sprite"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_stat_box"
                    android:contentDescription="@string/home_pet_partner_title"
                    android:padding="6dp"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_pet_name"
                            style="@style/HqText.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            tools:text="Wood Rat (木鼠)" />

                        <TextView
                            android:id="@+id/tv_pet_rarity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/hq_gold"
                            android:textSize="12sp"
                            tools:text="🟢 Common" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_pet_mood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/hq_text_secondary"
                        android:textSize="12sp"
                        tools:text="✨ Energetic &amp; Happy!" />

                    <!-- Affection Progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_pet_affection"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="100"
                            app:indicatorColor="@color/hq_crimson"
                            app:trackColor="@color/hq_surface_high"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="6dp" />

                        <TextView
                            android:id="@+id/tv_pet_affection_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/hq_crimson"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="❤️ 60%" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- State: Loading / Error / No Pet Owned -->
            <LinearLayout
                android:id="@+id/layout_no_pet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tv_no_pet_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏳"
                    android:textSize="36sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_no_pet_title"
                        style="@style/HqText.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calling Your Companion..."
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_no_pet_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Connecting to the Tamagotchi Sanctuary..."
                        android:textColor="@color/hq_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Merchant Shop & Inventory Bag Quick Hub Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Merchant Shop Quick Card -->
            <LinearLayout
                android:id="@+id/card_merchant_shop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_emblem"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="🏪"
                        android:textSize="18sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/hq_gold"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Merchant Shop"
                    android:textColor="@color/hq_gold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_home_shop_sub"
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Potions, Meals &amp; Pet Treats"
                    android:textColor="@color/hq_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Inventory Bag Quick Card -->
            <LinearLayout
                android:id="@+id/card_inventory_bag"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_emblem"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="🎒"
                        android:textSize="18sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/hq_gold"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Inventory Bag"
                    android:textColor="@color/hq_gold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_home_bag_summary"
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tap to view &amp; eat food"
                    android:textColor="@color/hq_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pleco-Style HSK Dictionary & Trace Lab Shortcut Card -->
        <LinearLayout
            android:id="@+id/card_hsk_dictionary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_emblem"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="📖"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/HqText.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HSK 1–9 Dictionary &amp; Writing Lab"
                    android:textColor="@color/hq_gold"
                    android:textSize="15sp" />

                <TextView
                    style="@style/HqText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Search Hanzi, Pinyin, or English · Listen TTS &amp; Trace Strokes"
                    android:textColor="@color/hq_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="@color/hq_gold"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress_home_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/hq_gold"
        android:visibility="gone" />

</FrameLayout>
