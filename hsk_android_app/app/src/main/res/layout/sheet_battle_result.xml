<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_raised"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_result_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_emblem"
        android:gravity="center"
        android:textSize="28sp"
        tools:text="🏆" />

    <TextView
        android:id="@+id/tv_result_title"
        style="@style/HqText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/hq_gold"
        android:textSize="24sp"
        tools:text="VICTORY!" />

    <TextView
        android:id="@+id/tv_result_message"
        style="@style/HqText.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        tools:text="Victory! +15 XP, +10 Coins" />

    <!-- Level Up Banner -->
    <TextView
        android:id="@+id/tv_level_up_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_gold_border"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/hq_gold"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="🎉 Level Up! You reached Level 2!"
        tools:visibility="visible" />

    <!-- Lost Equipment Alert -->
    <TextView
        android:id="@+id/tv_lost_item_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_option_wrong"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/hq_crimson"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="⚠️ You lost: wooden_sword!"
        tools:visibility="visible" />

    <!-- Rewards Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_xp_reward"
                style="@style/HqText.PixelStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hq_jade"
                android:textSize="20sp"
                tools:text="+15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XP Earned"
                android:textColor="@color/hq_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_coins_reward"
                style="@style/HqText.PixelStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hq_gold"
                android:textSize="20sp"
                tools:text="+10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coins"
                android:textColor="@color/hq_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_damage_dealt_stat"
                style="@style/HqText.PixelStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hq_text_primary"
                android:textSize="20sp"
                tools:text="50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Damage"
                android:textColor="@color/hq_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_fight_again"
        style="@style/HqButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/battle_fight_again" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_return_world_map"
        style="@style/HqButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/battle_return_map" />

</LinearLayout>
