<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/hq_bg_deep"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/HqText.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎒 Pet Inventory"
            android:textColor="@color/hq_gold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_sheet_inventory_count"
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_stat_box"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/hq_sky"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="6 Spirits" />
    </LinearLayout>

    <TextView
        style="@style/HqText.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Sorted highest rarity first · Tap any companion card to equip."
        android:textColor="@color/hq_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_sheet_inventory_empty"
        style="@style/HqText.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:padding="20dp"
        android:text="No spirit pets yet! Visit the Celestial Gacha Shrine to summon companions."
        android:textColor="@color/hq_text_muted"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_inventory_pets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_max="340dp"
            app:layout_constraintTop_toTopOf="parent"
            tools:listitem="@layout/item_pet_card" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_pet_inventory"
        style="@style/HqButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Close"
        android:textColor="@color/hq_text_secondary"
        app:cornerRadius="12dp"
        app:strokeColor="@color/hq_text_muted" />

</LinearLayout>
