<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stage_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Left Column: Stage Badge & Stars -->
    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_stage_number"
            style="@style/HqText.PixelStat"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_stat_box"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:textColor="@color/hq_gold"
            android:textSize="13sp"
            tools:text="1-1" />

        <TextView
            android:id="@+id/tv_stage_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="⭐⭐⭐"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Center Column: Title, Subtitle, Stats & Rewards -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_stage_title"
            style="@style/HqText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp"
            tools:text="Green Bamboo Goblin #1" />

        <TextView
            android:id="@+id/tv_stage_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hq_text_muted"
            android:textSize="11sp"
            tools:text="HSK 1 Normal Encounter" />

        <TextView
            android:id="@+id/tv_monster_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hq_text_secondary"
            android:textSize="11sp"
            tools:text="❤️ 50 HP · 🛡️ 0 DEF · ⚔️ 5 Dmg" />

        <TextView
            android:id="@+id/tv_rewards_preview"
            style="@style/HqText.PixelStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/hq_jade"
            android:textSize="13sp"
            tools:text="+15 XP · +10 🪙" />
    </LinearLayout>

    <!-- Right Column: Compact Challenge CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_stage_action"
        style="@style/HqButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="92dp"
        android:minHeight="40dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="0dp"
        android:text="Battle"
        android:textSize="12sp"
        app:cornerRadius="12dp" />

</LinearLayout>
