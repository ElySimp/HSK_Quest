<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/battle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:padding="16dp">

    <!-- Top Action Bar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_flee"
        style="@style/HqButton.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minHeight="40dp"
        android:paddingHorizontal="14dp"
        android:text="@string/battle_flee"
        android:textColor="@color/hq_crimson"
        android:textSize="12sp"
        app:icon="@android:drawable/ic_menu_revert"
        app:iconSize="14dp"
        app:iconTint="@color/hq_crimson"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/hq_crimson" />

    <TextView
        android:id="@+id/tv_stage_label"
        style="@style/HqText.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/hq_text_muted"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/btn_flee"
        app:layout_constraintEnd_toStartOf="@id/tv_combo"
        app:layout_constraintStart_toEndOf="@id/btn_flee"
        app:layout_constraintTop_toTopOf="@id/btn_flee"
        tools:text="HSK 1 · Normal" />

    <TextView
        android:id="@+id/tv_combo"
        style="@style/HqText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/hq_gold"
        android:textSize="16sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/btn_flee"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_flee"
        tools:text="3 COMBO"
        tools:visibility="visible" />

    <!-- Monster Zone Card -->
    <LinearLayout
        android:id="@+id/card_monster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_raised"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/btn_flee">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_monster_name"
                style="@style/HqText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                tools:text="HSK 1 Normal #1" />

            <TextView
                android:id="@+id/tv_monster_hp_numeric"
                style="@style/HqText.PixelStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hq_crimson"
                android:textSize="16sp"
                tools:text="50/50" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_monster_hp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="100"
            app:indicatorColor="@color/hq_crimson"
            app:trackColor="@color/hq_surface"
            app:trackCornerRadius="3dp"
            app:trackThickness="8dp" />

        <!-- Monster Animated Sprite -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/iv_monster_sprite"
                android:layout_width="140dp"
                android:layout_height="90dp"
                android:contentDescription="Monster Sprite"
                android:scaleType="fitCenter" />

            <!-- Floating Damage Text Popup -->
            <TextView
                android:id="@+id/tv_damage_popup"
                style="@style/HqText.PixelStat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0"
                android:textColor="@color/hq_gold"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:alpha="1"
                tools:text="-15 CRIT!" />
        </FrameLayout>
    </LinearLayout>

    <!-- Player Status Bar -->
    <LinearLayout
        android:id="@+id/card_player_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/card_monster">

        <TextView
            android:id="@+id/tv_player_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hero HP"
            android:textColor="@color/hq_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_player_hp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="100"
            app:indicatorColor="@color/hq_jade"
            app:trackColor="@color/hq_surface_high"
            app:trackCornerRadius="3dp"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/tv_player_hp_numeric"
            style="@style/HqText.PixelStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hq_jade"
            android:textSize="15sp"
            tools:text="100/100" />
    </LinearLayout>

    <!-- Question Prompt Card -->
    <LinearLayout
        android:id="@+id/card_question"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="10dp"
        android:background="@drawable/bg_card_raised"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/progress_timer"
        app:layout_constraintTop_toBottomOf="@id/card_player_status">

        <TextView
            android:id="@+id/tv_question_type"
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hq_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="TRANSLATE TO HANZI" />

        <TextView
            android:id="@+id/tv_prompt_primary"
            style="@style/HqText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="26sp"
            tools:text="to love; to be fond of" />

        <TextView
            android:id="@+id/tv_prompt_sub"
            style="@style/HqText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/hq_text_muted"
            android:textSize="13sp"
            tools:text="ài" />
    </LinearLayout>

    <!-- Timer Countdown Bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:max="1000"
        android:progress="1000"
        app:indicatorColor="@color/hq_gold"
        app:layout_constraintBottom_toTopOf="@id/grid_options"
        app:trackColor="@color/hq_surface_high"
        app:trackCornerRadius="2dp"
        app:trackThickness="6dp" />

    <!-- 2x2 Answer Grid -->
    <LinearLayout
        android:id="@+id/grid_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_option_0"
                style="@style/HqText.Title"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_option_idle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textSize="18sp"
                tools:text="爱" />

            <TextView
                android:id="@+id/btn_option_1"
                style="@style/HqText.Title"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_option_idle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textSize="18sp"
                tools:text="八" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_option_2"
                style="@style/HqText.Title"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_option_idle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textSize="18sp"
                tools:text="爸爸" />

            <TextView
                android:id="@+id/btn_option_3"
                style="@style/HqText.Title"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_option_idle"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textSize="18sp"
                tools:text="吧" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
