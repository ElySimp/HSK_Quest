<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.faldo.hsk_quest.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.faldo.hsk_quest.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/fade_out"
            app:popEnterAnim="@android:anim/fade_in"
            app:popExitAnim="@android:anim/slide_out_right" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.faldo.hsk_quest.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.faldo.hsk_quest.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_worldmap"
            app:destination="@id/worldMapFragment" />
        <action
            android:id="@+id/action_home_to_character"
            app:destination="@id/characterFragment" />
        <action
            android:id="@+id/action_home_to_shop"
            app:destination="@id/shopFragment" />
        <action
            android:id="@+id/action_home_to_gacha"
            app:destination="@id/gachaFragment" />
        <action
            android:id="@+id/action_home_to_leaderboard"
            app:destination="@id/leaderboardFragment" />
        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/worldMapFragment"
        android:name="com.faldo.hsk_quest.ui.worldmap.WorldMapFragment"
        android:label="@string/nav_world_map"
        tools:layout="@layout/fragment_world_map">
        <action
            android:id="@+id/action_worldmap_to_battle"
            app:destination="@id/battleFragment" />
    </fragment>

    <fragment
        android:id="@+id/battleFragment"
        android:name="com.faldo.hsk_quest.ui.battle.BattleFragment"
        android:label="@string/title_battle"
        tools:layout="@layout/fragment_battle">
        <argument
            android:name="areaId"
            android:defaultValue="1"
            app:argType="integer" />
        <argument
            android:name="monsterType"
            android:defaultValue="normal"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/characterFragment"
        android:name="com.faldo.hsk_quest.ui.character.CharacterFragment"
        android:label="@string/nav_character"
        tools:layout="@layout/fragment_character" />

    <fragment
        android:id="@+id/petFragment"
        android:name="com.faldo.hsk_quest.ui.pet.PetFragment"
        android:label="@string/nav_pet"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/shopFragment"
        android:name="com.faldo.hsk_quest.ui.shop.ShopFragment"
        android:label="@string/nav_shop"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/gachaFragment"
        android:name="com.faldo.hsk_quest.ui.gacha.GachaFragment"
        android:label="@string/nav_gacha"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.faldo.hsk_quest.ui.leaderboard.LeaderboardFragment"
        android:label="@string/nav_leaderboard"
        tools:layout="@layout/fragment_placeholder" />

    <fragment
        android:id="@+id/practiceFragment"
        android:name="com.faldo.hsk_quest.ui.practice.PracticeFragment"
        android:label="@string/nav_practice"
        tools:layout="@layout/fragment_practice" />
</navigation>
