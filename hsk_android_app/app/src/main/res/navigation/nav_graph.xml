<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.faldo.hsk_quest.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.faldo.hsk_quest.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/slide_in_right_fade"
            app:exitAnim="@anim/slide_out_left_fade"
            app:popEnterAnim="@anim/slide_in_left_fade"
            app:popExitAnim="@anim/slide_out_right_fade" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.faldo.hsk_quest.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_home"
            app:destination="@id/homeFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.faldo.hsk_quest.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_worldmap"
            app:destination="@id/worldMapFragment"
            app:enterAnim="@anim/slide_in_right_fade"
            app:exitAnim="@anim/slide_out_left_fade"
            app:popEnterAnim="@anim/slide_in_left_fade"
            app:popExitAnim="@anim/slide_out_right_fade" />
        <action
            android:id="@+id/action_home_to_character"
            app:destination="@id/characterFragment"
            app:enterAnim="@anim/slide_in_right_fade"
            app:exitAnim="@anim/slide_out_left_fade"
            app:popEnterAnim="@anim/slide_in_left_fade"
            app:popExitAnim="@anim/slide_out_right_fade" />
        <action
            android:id="@+id/action_home_to_shop"
            app:destination="@id/shopFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popEnterAnim="@anim/screen_pop_enter"
            app:popExitAnim="@anim/screen_pop_exit" />
        <action
            android:id="@+id/action_home_to_gacha"
            app:destination="@id/gachaFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popEnterAnim="@anim/screen_pop_enter"
            app:popExitAnim="@anim/screen_pop_exit" />
        <action
            android:id="@+id/action_home_to_leaderboard"
            app:destination="@id/leaderboardFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popEnterAnim="@anim/screen_pop_enter"
            app:popExitAnim="@anim/screen_pop_exit" />
        <action
            android:id="@+id/action_home_to_pet"
            app:destination="@id/petFragment"
            app:enterAnim="@anim/slide_in_right_fade"
            app:exitAnim="@anim/slide_out_left_fade"
            app:popEnterAnim="@anim/slide_in_left_fade"
            app:popExitAnim="@anim/slide_out_right_fade" />
        <action
            android:id="@+id/action_home_to_practice"
            app:destination="@id/practiceFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popEnterAnim="@anim/screen_pop_enter"
            app:popExitAnim="@anim/screen_pop_exit" />
        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/loginFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/worldMapFragment"
        android:name="com.faldo.hsk_quest.ui.worldmap.WorldMapFragment"
        android:label="@string/nav_world_map"
        tools:layout="@layout/fragment_world_map">
        <action
            android:id="@+id/action_worldmap_to_battle"
            app:destination="@id/battleFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popEnterAnim="@anim/screen_pop_enter"
            app:popExitAnim="@anim/screen_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/battleFragment"
        android:name="com.faldo.hsk_quest.ui.battle.BattleFragment"
        android:label="@string/title_battle"
        tools:layout="@layout/fragment_battle">
        <argument
            android:name="areaId"
            android:defaultValue="1"
            app:argType="integer" />
        <argument
            android:name="monsterType"
            android:defaultValue="normal"
            app:argType="string" />
        <argument
            android:name="monsterIndex"
            android:defaultValue="1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/characterFragment"
        android:name="com.faldo.hsk_quest.ui.character.CharacterFragment"
        android:label="@string/nav_character"
        tools:layout="@layout/fragment_character">
        <action
            android:id="@+id/action_character_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popEnterAnim="@anim/screen_pop_enter"
            app:popExitAnim="@anim/screen_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/questFragment"
        android:name="com.faldo.hsk_quest.ui.quest.QuestFragment"
        android:label="@string/nav_quest"
        tools:layout="@layout/fragment_quest" />

    <fragment
        android:id="@+id/petFragment"
        android:name="com.faldo.hsk_quest.ui.pet.PetFragment"
        android:label="@string/nav_pet"
        tools:layout="@layout/fragment_pet" />

    <fragment
        android:id="@+id/shopFragment"
        android:name="com.faldo.hsk_quest.ui.shop.ShopFragment"
        android:label="@string/nav_shop"
        tools:layout="@layout/fragment_shop" />

    <fragment
        android:id="@+id/gachaFragment"
        android:name="com.faldo.hsk_quest.ui.gacha.GachaFragment"
        android:label="@string/nav_gacha"
        tools:layout="@layout/fragment_gacha" />

    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.faldo.hsk_quest.ui.leaderboard.LeaderboardFragment"
        android:label="@string/nav_leaderboard"
        tools:layout="@layout/fragment_leaderboard" />

    <fragment
        android:id="@+id/practiceFragment"
        android:name="com.faldo.hsk_quest.ui.practice.PracticeFragment"
        android:label="HSK Dictionary &amp; Lab"
        tools:layout="@layout/fragment_practice">
        <action
            android:id="@+id/action_practice_to_camera_ocr"
            app:destination="@id/cameraOcrFragment"
            app:enterAnim="@anim/screen_enter"
            app:exitAnim="@anim/screen_exit"
            app:popEnterAnim="@anim/screen_pop_enter"
            app:popExitAnim="@anim/screen_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/cameraOcrFragment"
        android:name="com.faldo.hsk_quest.ui.ocr.CameraOcrFragment"
        android:label="Live Hanzi Camera OCR"
        tools:layout="@layout/fragment_camera_ocr" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.faldo.hsk_quest.ui.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />
</navigation>
