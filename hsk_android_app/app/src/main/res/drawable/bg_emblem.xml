<?xml version="1.0" encoding="utf-8"?>
<!-- Circular gold-ringed emblem with subtle outer radial glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#28D4AF6A" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#FF25242E"
                android:endColor="@color/hq_bg_deep"
                android:gradientRadius="90dp"
                android:startColor="#FF353240"
                android:type="radial" />
            <stroke
                android:width="2dp"
                android:color="@color/hq_gold" />
        </shape>
    </item>
</layer-list>
