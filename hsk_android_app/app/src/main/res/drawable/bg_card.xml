<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/hq_gold_glow">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF1E202A"
                android:endColor="#FF161820" />
            <stroke
                android:width="1dp"
                android:color="@color/hq_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
